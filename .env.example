# Copy this file to .env and fill in real values. Never commit .env.

# Where Prism reads its routes and providers from.
PRISM_CONFIG=config/prism.yaml

# Where Prism keeps its data. SQLite is fine for a single machine.
PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism.db

# Secret used to hash virtual keys. At least 32 characters. If it changes, every key stops
# working. Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
PRISM_KEY_PEPPER=

# Optional. Set when running more than one Prism instance (pip install 'prismgw[redis]').
# PRISM_REDIS_URL=redis://localhost:6379/0

# Provider keys. The config file names these variables; it never holds the keys.
GROQ_KEY_1=
GROQ_KEY_2=
GEMINI_KEY_1=
