# Copy this file to .env and fill in real values. Never commit .env.

# Where Prism reads its routes and providers from.
PRISM_CONFIG=config/prism.yaml

# Where Prism keeps its data. SQLite is fine for a single machine.
PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism.db

# Provider keys. The config file names these variables; it never holds the keys.
GROQ_KEY_1=
GROQ_KEY_2=
GEMINI_KEY_1=
